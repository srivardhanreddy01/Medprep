# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public URL of this app, used for email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider (server-only; never prefix with NEXT_PUBLIC_) ---
# anthropic (default) | fixture (deterministic test provider, disabled in production)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=high

# Max AI generations (analysis + flashcards) per user per hour
AI_JOBS_PER_HOUR=30
